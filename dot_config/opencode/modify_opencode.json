{{- /* chezmoi:modify-template */ -}}
{{- $config := dict -}}
{{- if ne (trim .chezmoi.stdin) "" -}}
  {{- $config = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $managed := includeTemplate "opencode.json.tmpl" . | fromJson -}}
{{- /* Keep local model/agent selections and unrelated settings. The repo owns
      provider routing and model limits, and adds its disabled provider. */ -}}
{{- $disabled := concat (get $config "disabled_providers" | default list) $managed.disabled_providers | uniq -}}
{{- /* The local plugin is auto-discovered; retire redundant explicit paths and
      add repo-managed plugins while keeping local entries. */ -}}
{{- $localPlugins := get $config "plugins" | default list -}}
{{- $managedPlugins := get $managed "plugins" | default list -}}
{{- $oldPath := joinPath .chezmoi.destDir ".config" "opencode" "plugins" "openai-allowlist" | replace "\\" "/" -}}
{{- $path := joinPath .chezmoi.destDir ".config" "opencode" "plugins" "my-opencode" | replace "\\" "/" -}}
{{- $plugins := list -}}
{{- range concat $localPlugins $managedPlugins | uniq -}}
  {{- $normalized := . -}}
  {{- if kindIs "string" . -}}{{- $normalized = replace "\\" "/" . -}}{{- end -}}
  {{- if and (ne (toJson $normalized) (toJson $oldPath)) (ne (toJson $normalized) (toJson $path)) -}}
    {{- $plugins = append $plugins . -}}
  {{- end -}}
{{- end -}}
{{- /* Retire all OpenAI provider overrides, including previously deployed routing,
      credentials references and model limits, in both legacy and V2 shapes. */ -}}
{{- range $key := list "provider" "providers" -}}
  {{- if hasKey $config $key -}}
    {{- $providers := index $config $key -}}
    {{- $_ := unset $providers "openai" -}}
    {{- if eq (len $providers) 0 -}}{{- $_ := unset $config $key -}}{{- end -}}
  {{- end -}}
{{- end -}}
{{- $config = mustMergeOverwrite $config $managed -}}
{{- $config = setValueAtPath "plugins" $plugins $config -}}
{{- /* Migrate only known RawRoute OAI aliases in OpenCode's model-selection fields.
      Keep variants and all custom/provider selections untouched. */ -}}
{{- $modelAliases := dict "rawroute/oai-base" "rawroute/gpt-base" "rawroute/oai-core" "rawroute/gpt-core" "rawroute/oai-peak" "rawroute/gpt-peak" -}}
{{- range $key := list "model" "small_model" -}}
  {{- $selection := get $config $key -}}
  {{- if kindIs "string" $selection -}}
    {{- range $old, $new := $modelAliases -}}
      {{- if or (eq $selection $old) (hasPrefix (printf "%s#" $old) $selection) -}}
        {{- $_ := set $config $key (printf "%s%s" $new (trimPrefix $old $selection)) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- range $scope := list "agents" "agent" -}}
  {{- $agents := get $config $scope -}}
  {{- if kindIs "map" $agents -}}
    {{- range $agent := $agents -}}
      {{- if kindIs "map" $agent -}}
        {{- $selection := get $agent "model" -}}
        {{- if kindIs "string" $selection -}}
          {{- range $old, $new := $modelAliases -}}
            {{- if or (eq $selection $old) (hasPrefix (printf "%s#" $old) $selection) -}}
              {{- $_ := set $agent "model" (printf "%s%s" $new (trimPrefix $old $selection)) -}}
            {{- end -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- /* Retired RawRoute models must be removed: a merge alone retains old entries. */ -}}
{{- range $retired := list "step-5-preview" "atria-dawn" "deepseek-v4.1-flash-1017" "spark" "cipher" "oai-base" "oai-core" "oai-peak" -}}
  {{- $_ := unset $config.providers.rawroute.models $retired -}}
{{- end -}}
{{- /* RawRoute input limits are intentionally omitted; remove legacy values,
      including from locally-added models under this provider. */ -}}
{{- range $model := $config.providers.rawroute.models -}}
  {{- if hasKey $model "limit" -}}
    {{- $_ := unset $model.limit "input" -}}
  {{- end -}}
{{- end -}}
{{- /* These models support reasoning without selectable effort variants. Replace
      nested metadata so stale toggle/effort keys do not survive deep merging. */ -}}
{{- range $id := list "base-flash" "gpt-base" "gpt-core" "gpt-peak" -}}
  {{- $model := index $config.providers.rawroute.models $id -}}
  {{- if and $model (hasKey $model "capabilities") -}}
    {{- $_ := set $model.capabilities "reasoning" (dict "supported" true) -}}
  {{- end -}}
{{- end -}}
{{- $config = setValueAtPath "disabled_providers" $disabled $config -}}
{{- $config | toPrettyJson }}
