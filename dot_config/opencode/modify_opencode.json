{{- /* chezmoi:modify-template */ -}}
{{- $config := dict -}}
{{- if ne (trim .chezmoi.stdin) "" -}}
  {{- $config = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $managed := includeTemplate "opencode.json.tmpl" . | fromJson -}}
{{- /* Keep local model/agent selections and unrelated settings. The repo owns
      provider routing and model limits, and adds its disabled provider. */ -}}
{{- $disabled := concat (get $config "disabled_providers" | default list) $managed.disabled_providers | uniq -}}
{{- /* The local plugin is auto-discovered. Retire its redundant explicit paths
      and the former Antigravity plugin, preserving unrelated entries. */ -}}
{{- $localPlugins := get $config "plugins" | default list -}}
{{- $managedPlugins := get $managed "plugins" | default list -}}
{{- $oldPath := joinPath .chezmoi.destDir ".config" "opencode" "plugins" "openai-allowlist" | replace "\\" "/" -}}
{{- $path := joinPath .chezmoi.destDir ".config" "opencode" "plugins" "my-opencode" | replace "\\" "/" -}}
{{- /* npm package name is the specifier without its version suffix. Scoped
      names start with "@", so only strip a final "@version" for them. */ -}}
{{- $managedPackages := list -}}
{{- $managedNames := list -}}
{{- $managedPaths := list -}}
{{- $retiredPlugins := list "@rasyid_rafi/opencode-antigravity" (joinPath .chezmoi.destDir "projects" "opencode-antigrvity") -}}
{{- range concat $managedPlugins $retiredPlugins -}}
  {{- $specifier := . -}}
  {{- if kindIs "map" . -}}{{- $specifier = get . "package" | default "" -}}{{- end -}}
  {{- if kindIs "string" $specifier -}}
    {{- $normalized := replace "\\" "/" $specifier -}}
    {{- if hasPrefix "@" $specifier -}}
      {{- $parts := splitList "@" $specifier -}}
      {{- $name := $specifier -}}
      {{- if gt (len $parts) 2 -}}{{- $name = printf "@%s" (index $parts 1) -}}{{- end -}}
      {{- $managedNames = append $managedNames (index (splitList "/" $name) 1) -}}
      {{- $managedPackages = append $managedPackages $name -}}
    {{- else if contains "/" $normalized -}}
      {{- $managedPaths = append $managedPaths $normalized -}}
    {{- else -}}
      {{- $parts := splitList "@" $specifier -}}
      {{- $name := index $parts 0 -}}
      {{- $managedNames = append $managedNames $name -}}
      {{- $managedPackages = append $managedPackages $name -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $plugins := list -}}
{{- range $localPlugins -}}
  {{- $specifier := . -}}
  {{- if kindIs "map" . -}}{{- $specifier = get . "package" | default "" -}}{{- end -}}
  {{- $normalized := $specifier -}}
  {{- if kindIs "string" $specifier -}}{{- $normalized = replace "\\" "/" $specifier -}}{{- end -}}
  {{- $include := true -}}
  {{- if and (kindIs "string" $normalized) (or (eq $normalized $oldPath) (eq $normalized $path) (has $normalized $managedPaths)) -}}
    {{- $include = false -}}
  {{- end -}}
  {{- if and $include (kindIs "string" $specifier) -}}
    {{- $name := $specifier -}}
    {{- $parts := splitList "@" $name -}}
    {{- if hasPrefix "@" $name -}}
      {{- if gt (len $parts) 2 -}}{{- $name = printf "@%s" (index $parts 1) -}}{{- end -}}
    {{- else -}}
      {{- $name = index $parts 0 -}}
    {{- end -}}
    {{- if has $name $managedPackages -}}{{- $include = false -}}{{- end -}}
    {{- /* A local checkout of a repo-managed package is retired too: read its
        package.json when present, otherwise fall back to the directory name. */ -}}
    {{- if and $include (not (hasPrefix "@" $specifier)) (contains "/" $normalized) -}}
      {{- $localName := base $normalized -}}
      {{- $pkgPath := printf "%s/package.json" (trimSuffix "/" $normalized) -}}
      {{- if stat $pkgPath -}}
        {{- $pkg := include $pkgPath | fromJson -}}
        {{- if kindIs "map" $pkg -}}{{- $localName = index $pkg "name" -}}{{- end -}}
      {{- end -}}
      {{- $localUnscoped := $localName -}}
      {{- if hasPrefix "@" $localName -}}{{- $localUnscoped = index (splitList "/" $localName) 1 -}}{{- end -}}
      {{- if has $localUnscoped $managedNames -}}{{- $include = false -}}{{- end -}}
    {{- end -}}
  {{- end -}}
  {{- if $include -}}{{- $plugins = append $plugins . -}}{{- end -}}
{{- end -}}
{{- range $managedPlugins -}}
  {{- $plugins = append $plugins . -}}
{{- end -}}
{{- /* Retire all OpenAI provider overrides, including previously deployed routing,
      credentials references and model limits, in both legacy and V2 shapes. */ -}}
{{- range $key := list "provider" "providers" -}}
  {{- if hasKey $config $key -}}
    {{- $providers := index $config $key -}}
    {{- $_ := unset $providers "openai" -}}
    {{- if eq (len $providers) 0 -}}{{- $_ := unset $config $key -}}{{- end -}}
  {{- end -}}
{{- end -}}
{{- $config = mustMergeOverwrite $config $managed -}}
{{- $config = setValueAtPath "plugins" $plugins $config -}}
{{- /* Migrate only known RawRoute OAI aliases in OpenCode's model-selection fields.
      Keep variants and all custom/provider selections untouched. */ -}}
{{- $modelAliases := dict "rawroute/oai-base" "rawroute/gpt-base" "rawroute/oai-core" "rawroute/gpt-core" "rawroute/oai-peak" "rawroute/gpt-peak" -}}
{{- range $key := list "model" "small_model" -}}
  {{- $selection := get $config $key -}}
  {{- if kindIs "string" $selection -}}
    {{- range $old, $new := $modelAliases -}}
      {{- if or (eq $selection $old) (hasPrefix (printf "%s#" $old) $selection) -}}
        {{- $_ := set $config $key (printf "%s%s" $new (trimPrefix $old $selection)) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- range $scope := list "agents" "agent" -}}
  {{- $agents := get $config $scope -}}
  {{- if kindIs "map" $agents -}}
    {{- range $agent := $agents -}}
      {{- if kindIs "map" $agent -}}
        {{- $selection := get $agent "model" -}}
        {{- if kindIs "string" $selection -}}
          {{- range $old, $new := $modelAliases -}}
            {{- if or (eq $selection $old) (hasPrefix (printf "%s#" $old) $selection) -}}
              {{- $_ := set $agent "model" (printf "%s%s" $new (trimPrefix $old $selection)) -}}
            {{- end -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- /* The managed agent files carry the disable flags. Drop older JSON overrides
      for those built-ins so other fields inherit OpenCode defaults. */ -}}
{{- range $scope := list "agents" "agent" -}}
  {{- $agents := get $config $scope -}}
  {{- if kindIs "map" $agents -}}
    {{- range $name := list "general" "explore" "reviewer" "plan" -}}
      {{- $_ := unset $agents $name -}}
    {{- end -}}
    {{- if eq (len $agents) 0 -}}{{- $_ := unset $config $scope -}}{{- end -}}
  {{- end -}}
{{- end -}}
{{- /* Retired RawRoute models must be removed: a merge alone retains old entries. */ -}}
{{- range $retired := list "step-5-preview" "atria-dawn" "deepseek-v4.1-flash-1017" "spark" "cipher" "oai-base" "oai-core" "oai-peak" "base-dawn" "base-flash" "base-cat" -}}
  {{- $_ := unset $config.providers.rawroute.models $retired -}}
{{- end -}}
{{- /* RawRoute input limits are intentionally omitted; remove legacy values,
      including from locally-added models under this provider. */ -}}
{{- range $model := $config.providers.rawroute.models -}}
  {{- if hasKey $model "limit" -}}
    {{- $_ := unset $model.limit "input" -}}
  {{- end -}}
{{- end -}}
{{- /* These models support reasoning without selectable effort variants. Replace
      nested metadata so stale toggle/effort keys do not survive deep merging. */ -}}
{{- range $id, $_ := .rawroute.models -}}
  {{- $model := index $config.providers.rawroute.models $id -}}
  {{- if and $model (hasKey $model "capabilities") -}}
    {{- $_ := set $model.capabilities "reasoning" (dict "supported" (index $.rawroute.models $id).reasoning) -}}
  {{- end -}}
{{- end -}}
{{- $config = setValueAtPath "disabled_providers" $disabled $config -}}
{{- $config | toPrettyJson }}
