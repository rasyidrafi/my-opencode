{{- /* chezmoi:modify-template */ -}}
{{- $raw := .chezmoi.stdin -}}
{{- $config := dict -}}
{{- if ne (trim .chezmoi.stdin) "" -}}
  {{- $config = mustFromJson .chezmoi.stdin -}}
{{- end -}}
{{- if not (kindIs "map" $config) -}}
  {{- fail "OpenChamber settings.json must be a JSON object" -}}
{{- end -}}
{{- /* Remove retired catalog/agent/variant overrides; Base Flash has no variant. */ -}}
{{- /* Catalog filtering is now handled by the OpenCode allowlist plugin. */ -}}
{{- $_ := unset $config "hiddenModels" -}}
{{- /* The repo intentionally leaves the default agent unset. */ -}}
{{- $_ := unset $config "defaultAgent" -}}
{{- /* Base Flash declares only reasoning.supported with no toggle/effort, so no variant selector exists. */ -}}
{{- $_ := unset $config "defaultVariant" -}}
{{- range list "smallModelUseDefault" "smallModelOverride" "smallModelVariant" -}}
  {{- $_ := unset $config . -}}
{{- end -}}
{{- /* The repo owns instance settings and the legacy model compatibility copy.
      Keep credentials, projects, session policies and other legacy profile
      copies untouched. */ -}}
{{- $managed := includeTemplate "openchamber/settings.json" . | mustFromJson -}}
{{- /* Right-hand managed values overwrite local values, including false. */ -}}
{{- $merged := mustMergeOverwrite $config $managed -}}
{{- $normalized := printf "%s\n" ($merged | toPrettyJson) -}}
{{- $output := $normalized -}}
{{- /* If the managed values already match, emit the original bytes so the
      app's own key order and EOF formatting stay untouched. */ -}}
{{- if ne (trim $raw) "" -}}
  {{- if eq (toJson $merged) (toJson (mustFromJson $raw)) -}}
    {{- $output = $raw -}}
  {{- end -}}
{{- end -}}
{{- $output -}}
