{{- $prefix := "RAWROUTE" -}}
{{- if stat (joinPath .chezmoi.destDir ".config" "rawroute" "local-enabled") -}}
  {{- $prefix = "RAWROUTE_LOCAL" -}}
{{- end -}}
{{- $urlEnv := printf "%s_BASE_URL" $prefix -}}
{{- $baseURL := printf "{env:%s}" $urlEnv -}}
{{- dict "urlEnv" $urlEnv "baseURL" $baseURL "envKey" (printf "%s_API_KEY" $prefix) | toJson -}}
