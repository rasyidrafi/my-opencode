{{- $models := dict -}}
{{- range $id, $model := .rawroute.models -}}
  {{- $_ := set $models $id (dict "name" $model.name "capabilities" (dict "tools" $model.tools "input" $model.input "output" $model.output "temperature" $model.temperature "reasoning" (dict "supported" $model.reasoning)) "limit" (dict "context" $model.context "output" $model.maxOutput)) -}}
{{- end -}}
{{- $route := includeTemplate "rawroute-endpoint" . | fromJson -}}
{{- $agentPolicy := includeTemplate "dot_config/opencode/plugins/my-opencode/agent-policy.json" . | mustFromJson -}}
{
  "websearch": false,
  "agents": {
    "title": {
      "model": "{{ $agentPolicy.titleModel }}"
    }
  },
  "default_agent": "{{ $agentPolicy.defaultAgent }}",
  "providers": {
    "rawroute": {
      "name": "RawRoute",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": [{{ $route.envKey | toJson }}],
      "settings": {
        "baseURL": {{ $route.baseURL | toJson }}
      },
      "models": {{ $models | toJson }}
    }
  },
  "disabled_providers": [
    "opencode"
  ],
  "plugins": [
    "@rasyid_rafi/opencode-muse@0.1.12",
    "@rasyid_rafi/opencode-antigravity@0.8.0"
  ]
}
