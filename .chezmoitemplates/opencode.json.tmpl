{{- $route := includeTemplate "rawroute-endpoint" . | fromJson -}}
{{- $agentPolicy := includeTemplate "dot_config/opencode/plugins/my-opencode/agent-policy.json" . | mustFromJson -}}
{
  "websearch": false,
  "agents": {
    "title": {
      "model": "{{ $agentPolicy.titleModel }}"
    }
  },
  "default_agent": "{{ $agentPolicy.defaultAgent }}",
  "providers": {
    "rawroute": {
      "name": "RawRoute",
      "env": [{{ $route.envKey | toJson }}],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": {{ $route.baseURL | toJson }}
      },
      "models": {
        "base-alpha": {
          "name": "Base Alpha",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
            "temperature": true,
            "reasoning": {
              "supported": true
            }
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "base-beta": {
          "name": "Base Beta",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
            "temperature": true,
            "reasoning": {
              "supported": true
            }
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "base-charlie": {
          "name": "Base Charlie",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
            "temperature": true,
            "reasoning": {
              "supported": true
            }
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "gpt-base": {
          "name": "GPT Base",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": true,
            "reasoning": {
              "supported": true
            }
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "gpt-core": {
          "name": "GPT Core",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": true,
            "reasoning": {
              "supported": true
            }
          },
          "limit": {
            "context": 640000,
            "output": 128000
          }
        },
        "gpt-peak": {
          "name": "GPT Peak",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": true,
            "reasoning": {
              "supported": true
            }
          },
          "limit": {
            "context": 400000,
            "output": 128000
          }
        }
      }
    }
  },
  "disabled_providers": [
    "opencode"
  ]
}
