{{- $local := stat (joinPath .chezmoi.homeDir ".config" "rawroute" "local-enabled") -}}
{{- $rawrouteLocal := stat (joinPath .chezmoi.homeDir ".config" "rawroute" "rawroute-local-enabled") -}}
{
  "websearch": false,
  "providers": {
    "rawroute": {
      "name": "RawRoute",
      "env": ["{{ if $rawrouteLocal }}RAWROUTE_LOCAL_API_KEY{{ else }}RAWROUTE_API_KEY{{ end }}"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{{ if $rawrouteLocal }}https://rawroute.tail8da2f2.ts.net/v1{{ else }}https://rawroute.qzz.io/v1{{ end }}"
      }
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        },
        "gpt-6-luna": {
          "limit": {
            "context": 680000,
            "input": 552000,
            "output": 128000
          }
        },
        "gpt-6-luna-fast": {
          "limit": {
            "context": 680000,
            "input": 552000,
            "output": 128000
          }
        },
        "gpt-6-astra": {
          "limit": {
            "context": 400000,
            "input": 272000,
            "output": 128000
          }
        }
      },
      "options": {
        "baseURL": "{{ if $local }}https://rawroute.qilin-elver.ts.net/v1{{ else }}https://ccs.halotec.my.id/v1{{ end }}",
        "apiKey": "{env:{{ if $local }}CCS_HALOTEC_LOCAL_API_KEY{{ else }}CCS_HALOTEC_API_KEY{{ end }}}"
      }
    }
  },
  "disabled_providers": [
    "opencode"
  ]
}
