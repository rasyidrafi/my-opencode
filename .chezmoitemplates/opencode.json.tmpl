{{- $rawrouteLocal := stat (joinPath .chezmoi.destDir ".config" "rawroute" "rawroute-local-enabled") -}}
{{- $agentPolicy := includeTemplate "dot_config/opencode/plugins/my-opencode/agent-policy.json" . | mustFromJson -}}
{
  "websearch": false,
  "plugins": ["@rasyid_rafi/opencode-muse"],
  "agents": {
    "title": {
      "model": "{{ $agentPolicy.titleModel }}"
    }
  },
  "providers": {
    "rawroute": {
      "name": "RawRoute",
      "env": ["{{ if $rawrouteLocal }}RAWROUTE_LOCAL_API_KEY{{ else }}RAWROUTE_API_KEY{{ end }}"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{{ if $rawrouteLocal }}https://rawroute.qilin-elver.ts.net/v1{{ else }}https://rawroute.qzz.io/v1{{ end }}"
      },
      "models": {
        "base-flash": {
          "name": "Base Flash",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": true,
            "reasoning": {
              "supported": true
            }
          },
          "limit": {
            "context": 1000000,
            "output": 256000
          }
        },
        "gpt-base": {
          "name": "GPT Base",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": true,
            "reasoning": {
              "supported": true
            }
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "gpt-core": {
          "name": "GPT Core",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": true,
            "reasoning": {
              "supported": true
            }
          },
          "limit": {
            "context": 640000,
            "output": 128000
          }
        },
        "gpt-peak": {
          "name": "GPT Peak",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": true,
            "reasoning": {
              "supported": true
            }
          },
          "limit": {
            "context": 400000,
            "output": 128000
          }
        }
      }
    }
  },
  "disabled_providers": [
    "opencode"
  ]
}
